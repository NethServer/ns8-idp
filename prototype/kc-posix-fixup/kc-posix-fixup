#!/usr/bin/env python3

#
# Prototype (NethServer/dev#8080, scenario 2, option A).
# Keycloak creates LDAP entries with placeholder posixAccount values:
# assign a real uidNumber, homeDirectory and displayName, like the
# OpenLDAP add-user command does.
#

import os
import sys
import ldap3

PLACEHOLDER_UID = 1000
LDAP_URL = 'ldap://127.0.0.1:20005'
BASE_DN = 'dc=ldap,dc=dom,dc=test'
PEOPLE_DN = 'ou=People,' + BASE_DN
BIND_DN = 'uid=keycloak-svc,' + PEOPLE_DN

with open(os.path.join(os.environ['AGENT_STATE_DIR'], 'ldap-svc.pw')) as fp:
    bind_password = fp.read()

conn = ldap3.Connection(ldap3.Server(LDAP_URL), BIND_DN, bind_password, auto_bind=True, raise_exceptions=False)

conn.search(PEOPLE_DN, f'(&(objectClass=posixAccount)(uidNumber={PLACEHOLDER_UID}))',
    attributes=['uid', 'cn', 'sn', 'displayName'])
pending = list(conn.entries)
if not pending:
    sys.exit(0)

conn.search(PEOPLE_DN, '(&(objectClass=posixAccount)(uidNumber=*))', attributes=['uidNumber'])
next_uid = max([int(e.uidNumber.value) for e in conn.entries] + [PLACEHOLDER_UID]) + 1

errors = 0
for entry in pending:
    uid = entry.uid.value
    changes = {
        # Delete the placeholder and add the new value in one operation:
        # it fails if the entry was fixed in the meantime.
        'uidNumber': [(ldap3.MODIFY_DELETE, [str(PLACEHOLDER_UID)]), (ldap3.MODIFY_ADD, [str(next_uid)])],
        'homeDirectory': [(ldap3.MODIFY_REPLACE, [f'/home/{uid}'])],
    }
    if not entry.displayName.value:
        display_name = ' '.join(filter(None, [entry.cn.value, entry.sn.value])) or uid
        changes['displayName'] = [(ldap3.MODIFY_REPLACE, [display_name])]
    if conn.modify(entry.entry_dn, changes):
        print(f'kc-posix-fixup: {uid} uidNumber={next_uid}', file=sys.stderr)
        next_uid += 1
    else:
        print(f'kc-posix-fixup: {uid} modify failed: {conn.result["description"]} {conn.result["message"]}', file=sys.stderr)
        errors += 1

sys.exit(1 if errors else 0)
