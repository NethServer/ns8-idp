[Unit]
Description=Keycloak server
BindsTo=idp.service
Requires=keycloak-init.service
After=idp.service postgres.service keycloak-init.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
TimeoutStartSec=180
ExecStartPre=/bin/rm -f %t/keycloak.ctr-id
# The unit is active when the health check reports Keycloak as ready.
# The probe script of the image waits until Keycloak is ready in the
# startup check, so Podman runs it once per start.
ExecStart=/usr/bin/podman run \
    --detach \
    --sdnotify=healthy \
    --health-startup-cmd="/opt/keycloak/bin/ns8-healthcheck --wait" \
    --health-startup-timeout=150s \
    --health-startup-interval=2s \
    --health-cmd=/opt/keycloak/bin/ns8-healthcheck \
    --health-interval=60s \
    --cidfile=%t/keycloak.ctr-id \
    --cgroups=no-conmon \
    --pod-id-file=%t/idp.pod-id \
    --replace --name=%N \
    --env-file=%E/etc/keycloak.env \
    --env-file=./passwords.env \
    ${IDP_KEYCLOAK_IMAGE} \
        start --optimized \
        --hostname=https://${IDP_HOSTNAME}
ExecStartPost=-runagent keycloak-post-start
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/keycloak.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile=%t/keycloak.ctr-id
Type=notify
NotifyAccess=all
# The JVM exits with 128+SIGTERM on a normal stop
SuccessExitStatus=143
