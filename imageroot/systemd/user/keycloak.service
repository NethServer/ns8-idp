[Unit]
Description=Keycloak server
BindsTo=idp.service
Requires=keycloak-init.service
After=idp.service postgres.service keycloak-init.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
TimeoutStartSec=180
ExecStartPre=/bin/rm -f %t/keycloak.ctr-id
# The unit is active when the health check reports Keycloak as ready.
# The image has no curl: the check is a bash /dev/tcp request to the
# management port. The startup check waits internally until Keycloak is
# ready, so each start runs it once instead of logging a failed check
# every few seconds; each attempt runs in a subshell, because a failed
# exec redirection terminates the shell.
ExecStart=/usr/bin/podman run \
    --detach \
    --sdnotify=healthy \
    --health-startup-cmd='until (exec 3<>/dev/tcp/127.0.0.1/9000 && printf "GET /health/ready HTTP/1.0\\r\\n\\r\\n" >&3 && grep -q UP <&3) 2>/dev/null; do sleep 1; done' \
    --health-startup-timeout=150s \
    --health-startup-interval=2s \
    --health-cmd='exec 3<>/dev/tcp/127.0.0.1/9000 && printf "GET /health/ready HTTP/1.0\\r\\n\\r\\n" >&3 && grep -q UP <&3' \
    --health-interval=60s \
    --cidfile=%t/keycloak.ctr-id \
    --cgroups=no-conmon \
    --pod-id-file=%t/idp.pod-id \
    --replace --name=%N \
    --env-file=%E/etc/keycloak.env \
    --env-file=./passwords.env \
    ${IDP_KEYCLOAK_IMAGE} \
        start --optimized \
        --hostname=https://${IDP_HOSTNAME}
ExecStartPost=-runagent keycloak-post-start
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/keycloak.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile=%t/keycloak.ctr-id
Type=notify
NotifyAccess=all
# The JVM exits with 128+SIGTERM on a normal stop
SuccessExitStatus=143
