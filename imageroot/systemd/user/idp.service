#
# The idp pod holds the network namespace shared by the Keycloak and
# PostgreSQL containers. Only the Keycloak HTTP port is published.
#
[Unit]
Description=IdP pod (Keycloak and PostgreSQL)
Wants=postgres.service keycloak.service
Before=postgres.service keycloak-init.service keycloak.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/idp.pid %t/idp.pod-id
ExecStartPre=/usr/bin/podman pod create \
    --infra-conmon-pidfile=%t/idp.pid \
    --pod-id-file=%t/idp.pod-id \
    --name=%N \
    --network=pasta \
    --publish=127.0.0.1:${TCP_PORT}:8080 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file=%t/idp.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file=%t/idp.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file=%t/idp.pod-id
PIDFile=%t/idp.pid
Type=forking

[Install]
WantedBy=default.target
