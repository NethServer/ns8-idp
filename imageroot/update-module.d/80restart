# Run the new images and units. Services of a module that is not
# configured yet are not running, and stay stopped.

set -e
exec 1>&2

systemctl --user daemon-reload
# List every unit: restarting the pod alone does not restart its containers
systemctl --user try-restart idp.service postgres.service keycloak.service
