#
# Recover the service account of a writable realm, if it was removed
# from its user domain or its password was changed by mistake: create
# the account again, or reset its password, then apply the new
# credentials to the LDAP federation of the realm.
#
# Usage: runagent -m <module_id> register-service-account <realm>
#

import sys

import agent
import idpfed
import idprealm
import kcadmin

if len(sys.argv) != 2:
    print("Usage: register-service-account <realm>", file=sys.stderr)
    sys.exit(2)
realm = sys.argv[1]

idprealm.require_keycloak()

with idprealm.realms_lock():
    kc = kcadmin.agent_client()
    if realm not in kcadmin.managed_realms(kc):
        print(agent.SD_ERR + f"Realm {realm} not found", file=sys.stderr)
        sys.exit(1)
    if idpfed.user_domain_access(kc, realm) != "writable":
        print(agent.SD_ERR + f"Realm {realm} has no service account: it has read-only access to its user domain", file=sys.stderr)
        sys.exit(1)
    account = idpfed.ensure_service_account(realm, regenerate=True)
    idprealm.ensure_federation(kc, realm)

print(f"Service account {account['user']} of realm {realm} registered", file=sys.stderr)
