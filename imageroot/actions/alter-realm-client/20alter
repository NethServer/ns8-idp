import json
import sys

import idpaccess
import idprealm
import kcadmin

request = json.load(sys.stdin)
domain = request["domain"]
client_id = request["client_id"]

idprealm.require_keycloak()

with idprealm.realms_lock():
    kc = kcadmin.agent_client()
    if domain not in kcadmin.managed_realms(kc):
        idprealm.fail_validation("domain", domain, "realm_not_found")

    client = next((c for c in idprealm.module_clients(kc, domain) if c["clientId"] == client_id), None)
    if client is None:
        idprealm.fail_validation("client_id", client_id, "client_not_found")

    if "access_group" in request:
        if request["access_group"] is None:
            print(f"Removing the access group of client {client_id}", file=sys.stderr)
            idpaccess.clear_policy(kc, domain, client)
        else:
            print(f"Restricting client {client_id} to the members of {request['access_group']}", file=sys.stderr)
            try:
                idpaccess.set_policy(kc, domain, client, request["access_group"])
            except idpaccess.PolicyError as ex:
                idprealm.fail_validation("access_group", request["access_group"], ex.code)
        client = kc.get(f"/{domain}/clients/{client['id']}")

    if "enabled" in request:
        # register-client does not change the enabled flag: a disabled client
        # stays disabled when its module registers it again
        client["enabled"] = request["enabled"]
        kc.put(f"/{domain}/clients/{client['id']}", client)
