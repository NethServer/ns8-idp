import json
import os
import subprocess
import sys

import agent
import idprealm
import kcadmin

def fail_validation(parameter, value, error):
    agent.set_status("validation-failed")
    json.dump([{
        "field": parameter,
        "parameter": parameter,
        "value": value,
        "error": error,
    }], fp=sys.stdout)
    sys.exit(2)

request = json.load(sys.stdin)
domain = request["domain"]

# The client owner is the calling module. An explicit module_id is
# accepted only from tasks without a calling user, like those created by
# the cluster agent.
task_user = os.getenv("AGENT_TASK_USER", "")
if task_user:
    if "module_id" in request:
        fail_validation("module_id", request["module_id"], "module_id_not_allowed")
    if not task_user.startswith("module/"):
        fail_validation("module_id", task_user, "caller_not_a_module")
    module_id = task_user.removeprefix("module/")
elif "module_id" in request:
    module_id = request["module_id"]
else:
    fail_validation("module_id", "", "module_id_required")

rdb = agent.redis_connect(use_replica=True)
module_domains = (rdb.hget("cluster/module_domains", module_id) or "").split()
if domain not in module_domains:
    fail_validation("domain", domain, "domain_not_bound_to_module")

if subprocess.run(["systemctl", "--user", "-q", "is-active", "keycloak.service"]).returncode != 0:
    print(agent.SD_ERR + "keycloak.service is not active", file=sys.stderr)
    sys.exit(1)

# Serialize the registrations: the domain binding is replaced as a
# whole, and concurrent realm creations would conflict
with agent.exclusive_file_lock("register-client"):
    bound_domains = agent.get_bound_domain_list(rdb)
    if domain not in bound_domains:
        agent.bind_user_domains(bound_domains + [domain], check=True)

    kc = kcadmin.agent_client()
    idprealm.ensure_realm(kc, domain)
    client_secret = idprealm.ensure_client(kc, domain, module_id,
        redirect_uris=request.get("redirect_uris", []),
        post_logout_redirect_uris=request.get("post_logout_redirect_uris", []),
        web_origins=request.get("web_origins", []),
        audience=request.get("audience", []),
        rotate_secret=request.get("rotate_secret", False),
    )

json.dump({
    "client_id": module_id,
    "client_secret": client_secret,
    "realm": domain,
    "issuer": f"https://{os.environ['IDP_HOSTNAME']}/realms/{domain}",
}, fp=sys.stdout)
