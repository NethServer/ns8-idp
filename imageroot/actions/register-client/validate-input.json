{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "register-client input",
    "$id": "http://schema.nethserver.org/idp/register-client-input.json",
    "description": "Create or update the OIDC client of the calling module, in the realm of a user domain. The realm is created if missing. The client ID is the module ID.",
    "examples": [
        {
            "domain": "dp.example.org",
            "redirect_uris": [
                "https://cloud.example.org/apps/user_oidc/code"
            ],
            "post_logout_redirect_uris": [
                "https://cloud.example.org/*"
            ],
            "web_origins": [
                "https://cloud.example.org"
            ]
        },
        {
            "domain": "dp.example.org",
            "redirect_uris": [
                "https://webmail.example.org/index.php/login/oauth"
            ],
            "audience": [
                "mail1"
            ],
            "rotate_secret": true
        },
        {
            "domain": "dp.example.org",
            "redirect_uris": [
                "https://app.example.org/callback"
            ],
            "access_token_claims": {
                "app_principal_kind": "human"
            }
        }
    ],
    "type": "object",
    "required": [
        "domain"
    ],
    "properties": {
        "domain": {
            "description": "User domain of the realm. The calling module must be bound to it",
            "type": "string",
            "minLength": 1
        },
        "redirect_uris": {
            "description": "Redirect URIs of the authorization code flow. Without redirect URIs the client can only authenticate its own requests, for example token introspection",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "default": []
        },
        "post_logout_redirect_uris": {
            "description": "URIs where the logout redirects the user. Applications should pass their exact logout URI. If the attribute is missing, a wildcard URI for each origin of the redirect URIs is set, like https://cloud.example.org/*; an empty list allows none",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "web_origins": {
            "description": "Allowed CORS origins",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "default": []
        },
        "audience": {
            "description": "Client IDs added to the audience of the tokens, for example the mail module whose Dovecot introspects them",
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_.-]+$"
            },
            "default": []
        },
        "rotate_secret": {
            "description": "Generate a new client secret. Otherwise the current secret is returned",
            "type": "boolean",
            "default": false
        },
        "module_id": {
            "description": "Module that owns the client. Allowed only for tasks without a calling user, for example created by the cluster agent: otherwise the owner is the calling module",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "access_token_claims": {
            "description": "Up to eight fixed string claims on access tokens only. Custom top-level underscore names; reserved protocol, identity and authorization claims are rejected. Omit to preserve; {} removes only feature-owned claim mappers. Password, implicit and service-account grants remain disabled.",
            "type": "object",
            "maxProperties": 8,
            "propertyNames": {
                "allOf": [
                    {
                        "pattern": "^[a-z][a-z0-9]{0,15}_[a-z0-9_]{1,47}$"
                    },
                    {
                        "not": {
                            "enum": [
                                "token_type",
                                "auth_time",
                                "session_state",
                                "client_id",
                                "realm_access",
                                "resource_access",
                                "preferred_username",
                                "email_verified",
                                "given_name",
                                "family_name",
                                "ldap_uuid",
                                "at_hash",
                                "c_hash",
                                "s_hash",
                                "may_act"
                            ]
                        }
                    }
                ]
            },
            "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
        }
    }
}
