import json
import sys

import agent.ldapproxy
import idprealm
import kcadmin

idprealm.require_keycloak()
user_domains = agent.ldapproxy.Ldapproxy().get_domains_list()

kc = kcadmin.agent_client()
realms = []
for name in kcadmin.managed_realms(kc):
    clients = [{
        "client_id": client["clientId"],
        "enabled": client["enabled"],
    } for client in idprealm.module_clients(kc, name)]
    realms.append({
        "name": name,
        "enabled": kc.get(f"/{name}")["enabled"],
        "issuer": idprealm.issuer_url(name),
        "user_domain_found": name in user_domains,
        "clients": sorted(clients, key=lambda c: c["client_id"]),
    })

json.dump({"realms": sorted(realms, key=lambda r: r["name"])}, fp=sys.stdout)
