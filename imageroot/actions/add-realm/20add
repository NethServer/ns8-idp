import json
import sys

import agent.ldapproxy
import idprealm
import kcadmin

request = json.load(sys.stdin)
domain = request["domain"]

if domain not in agent.ldapproxy.Ldapproxy().get_domains_list():
    idprealm.fail_validation("domain", domain, "domain_not_found")

idprealm.require_keycloak()

with idprealm.realms_lock():
    kc = kcadmin.agent_client()
    if domain in kcadmin.managed_realms(kc):
        idprealm.fail_validation("domain", domain, "realm_already_exists")
    idprealm.bind_domain(domain)
    idprealm.ensure_realm(kc, domain)

json.dump({
    "name": domain,
    "issuer": idprealm.issuer_url(domain),
}, fp=sys.stdout)
