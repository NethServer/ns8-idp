{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "add-realm output",
    "$id": "http://schema.nethserver.org/idp/add-realm-output.json",
    "description": "The new realm",
    "examples": [
        {
            "name": "dp.example.org",
            "issuer": "https://sso.example.org/realms/dp.example.org"
        }
    ],
    "type": "object",
    "required": [
        "name",
        "issuer"
    ],
    "properties": {
        "name": {
            "type": "string"
        },
        "issuer": {
            "description": "OIDC issuer URL",
            "type": "string"
        }
    }
}
