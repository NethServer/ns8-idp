import json
import os
import sys

import agent

request = json.load(sys.stdin)
host = request["host"]

# The Let's Encrypt flag is stored by Traefik in the route
agent.set_env("IDP_HOSTNAME", host)

# Publish the OIDC provider for service discovery. The issuer of a user
# domain is the issuer_url_prefix followed by the domain name.
agent_id = os.environ["AGENT_ID"]
srv_key = f"{agent_id}/srv/http/oidc"
rdb = agent.redis_connect(privileged=True)
rdb.hset(srv_key, mapping={
    "host": host,
    "issuer_url_prefix": f"https://{host}/realms/",
})
rdb.publish(f"{agent_id}/event/service-oidc-changed", json.dumps({
    "key": srv_key,
    "module_id": os.environ["MODULE_ID"],
    "module_uuid": os.environ["MODULE_UUID"],
}))
